</div>

<script>
(function () {
    var basePath = window.location.pathname;
    var loaded = false;
    var cache = null;

    function esc(s) {
        return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function fmtSym(s) {
        if (!s) return '';
        return s.length === 6 ? s.slice(0, 3) + '/' + s.slice(3) : s;
    }
    function badgeClass(key) {
        if (key === 'dusuk') return 'ft-fa-badge-dusuk';
        if (key === 'yuksek') return 'ft-fa-badge-yuksek';
        return 'ft-fa-badge-normal';
    }
    function dotColor(key) {
        if (key === 'dusuk') return 'var(--ft-secondary)';
        if (key === 'yuksek') return 'var(--ft-danger)';
        return 'var(--ft-warning)';
    }
    function levelLabel(root, key) {
        if (key === 'dusuk') return root.getAttribute('data-trans-low');
        if (key === 'yuksek') return root.getAttribute('data-trans-high');
        return root.getAttribute('data-trans-normal');
    }
    function localizedByLevel(root, prefix, key, fallback) {
        var suffix = key === 'dusuk' ? 'low' : (key === 'yuksek' ? 'high' : 'normal');
        return root.getAttribute('data-trans-' + prefix + '-' + suffix) || fallback || '';
    }
    function localizedSignal(root, key, fallback) {
        if (key === 'buy') return root.getAttribute('data-trans-signal-buy');
        if (key === 'sell') return root.getAttribute('data-trans-signal-sell');
        return root.getAttribute('data-trans-no-opportunity') || fallback || '';
    }

    function getProp(obj, prop) {
        if (!obj) return undefined;
        if (obj[prop] !== undefined) return obj[prop];
        var pascal = prop.charAt(0).toUpperCase() + prop.slice(1);
        return obj[pascal];
    }
    function riskBarClass(pct) {
        if (pct < 34) return 'low';
        if (pct < 67) return 'normal';
        return 'high';
    }

    function renderRiskPct(score) {
        var pct = Math.min(100, Math.max(0, Math.round(score)));
        var cls = riskBarClass(pct);
        return '<div class="ft-risk-pct">' +
            '<span style="font-weight:800;font-size:0.9rem;min-width:38px;text-align:right">' + pct + '%</span>' +
            '<div class="ft-risk-bar-wrap"><div class="ft-risk-bar-fill ' + cls + '" style="width:' + pct + '%"></div></div>' +
            '</div>';
    }

    function updateSummaryCards(riskRows, volRows) {
        var riskEl  = document.getElementById('ft-fa-sv-risk');
        var riskDot = document.getElementById('ft-fa-dot-risk');
        var volEl   = document.getElementById('ft-fa-sv-vol');
        var volDot  = document.getElementById('ft-fa-dot-vol');
        var root    = document.getElementById('ft-financial-analytics-wrap');

        if (riskRows && riskRows.length > 0) {
            var sumRisk = 0;
            var highCount = 0, normalCount = 0;
            riskRows.forEach(function (r) {
                var s = Number(getProp(r, 'riskScore') || 0);
                sumRisk += s;
                var k = getProp(r, 'levelKey');
                if (k === 'yuksek') highCount++;
                else if (k === 'normal') normalCount++;
            });
            var avgRisk = sumRisk / riskRows.length;
            var pct = Math.round(avgRisk);

            var avgKey = pct < 34 ? 'dusuk' : (pct < 67 ? 'normal' : 'yuksek');
            if (highCount > 0) avgKey = 'yuksek';
            else if (normalCount > 0 && avgKey === 'dusuk') avgKey = 'normal';

            var label = avgKey === 'yuksek' ? root.getAttribute('data-trans-risk-high') : avgKey === 'normal' ? root.getAttribute('data-trans-risk-normal') : root.getAttribute('data-trans-risk-low');
            if (riskEl)  riskEl.textContent = label + ' (' + pct + '%)';
            if (riskDot) riskDot.style.background = dotColor(avgKey);
        } else {
            if (riskEl)  riskEl.textContent = root.getAttribute('data-trans-no-data');
            if (riskDot) riskDot.style.background = 'var(--ft-text-muted)';
        }

        if (volRows && volRows.length > 0) {
            var maxVol = 'dusuk';
            var order = { dusuk: 0, normal: 1, yuksek: 2 };
            volRows.forEach(function (r) {
                var k = getProp(r, 'levelKey') || 'normal';
                if ((order[k] || 0) > (order[maxVol] || 0)) maxVol = k;
            });
            var vlabel = maxVol === 'yuksek' ? root.getAttribute('data-trans-vol-high') : maxVol === 'normal' ? root.getAttribute('data-trans-vol-normal') : root.getAttribute('data-trans-vol-low');
            if (volEl)  volEl.textContent = vlabel;
            if (volDot) volDot.style.background = dotColor(maxVol);
        } else {
            if (volEl)  volEl.textContent = root.getAttribute('data-trans-no-data');
            if (volDot) volDot.style.background = 'var(--ft-text-muted)';
        }
    }

    function renderRisk(rows) {
        var tb = document.getElementById('ft-fa-risk-body');
        var root = document.getElementById('ft-financial-analytics-wrap');
        if (!tb) return;
        if (!rows || !rows.length) {
            tb.innerHTML = '<tr><td colspan="5" class="ft-fa-loading">' + root.getAttribute('data-trans-no-records') + '</td></tr>';
            return;
        }
        tb.innerHTML = rows.map(function (r) {
            var key = getProp(r, 'levelKey') || 'normal';
            return '<tr>' +
                '<td style="text-align:center;font-weight:700">' + esc(fmtSym(getProp(r, 'symbol'))) + '</td>' +
                '<td style="text-align:center">' + renderRiskPct(getProp(r, 'riskScore')) + '</td>' +
                '<td style="text-align:center"><span class="ft-fa-badge ' + badgeClass(key) + '">' + esc(levelLabel(root, key)) + '</span></td>' +
                '<td style="text-align:center;max-width:300px;font-size:0.82rem">' + esc(localizedByLevel(root, 'risk-summary', key, getProp(r, 'summaryWhat'))) + '</td>' +
                '<td style="text-align:center;font-size:0.82rem;max-width:280px">' + esc(localizedByLevel(root, 'risk-action', key, getProp(r, 'recommendedAction'))) + '</td>' +
                '</tr>';
        }).join('');
    }

    function renderVol(rows) {
        var tb = document.getElementById('ft-fa-vol-body');
        var root = document.getElementById('ft-financial-analytics-wrap');
        if (!tb) return;
        if (!rows || !rows.length) {
            tb.innerHTML = '<tr><td colspan="5" class="ft-fa-loading">' + root.getAttribute('data-trans-no-records') + '</td></tr>';
            return;
        }
        tb.innerHTML = rows.map(function (r) {
            var key = getProp(r, 'levelKey') || 'normal';
            return '<tr>' +
                '<td style="text-align:center;font-weight:700">' + esc(fmtSym(getProp(r, 'symbol'))) + '</td>' +
                '<td style="text-align:center;font-family:monospace">' + esc(Number(getProp(r, 'volatilityValue')).toFixed(4).replace('.', ',')) + '</td>' +
                '<td style="text-align:center"><span class="ft-fa-badge ' + badgeClass(key) + '">' + esc(levelLabel(root, key)) + '</span></td>' +
                '<td style="text-align:center;max-width:300px;font-size:0.82rem">' + esc(localizedByLevel(root, 'vol-summary', key, getProp(r, 'summaryWhat'))) + '</td>' +
                '<td style="text-align:center;font-size:0.82rem;max-width:280px">' + esc(localizedByLevel(root, 'vol-action', key, getProp(r, 'recommendedAction'))) + '</td>' +
                '</tr>';
        }).join('');
    }

    function wireTabs() {
        var root = document.getElementById('ft-financial-analytics-wrap');
        if (!root) return;
        var tabs = root.querySelectorAll('.ft-fa-tab');
        var panels = root.querySelectorAll('[data-ft-panel]');
        tabs.forEach(function (btn) {
            btn.addEventListener('click', function () {
                var sub = btn.getAttribute('data-ft-sub');
                tabs.forEach(function (t) { t.classList.remove('ft-fa-active'); });
                btn.classList.add('ft-fa-active');
                panels.forEach(function (p) {
                    var name = p.getAttribute('data-ft-panel');
                    if (name === sub) p.classList.remove('hidden');
                    else p.classList.add('hidden');
                });
            });
        });
    }

    var inflight = false;
    var refreshInterval = null;

    function startAutoRefresh() {
        if (refreshInterval) return;
        refreshInterval = setInterval(function() {
            var root = document.getElementById('ft-financial-analytics-wrap');
            if (!root) { stopAutoRefresh(); return; }
            
            // Eğer panel gizli değilse veriyi çek
            var container = root.closest('section') || root.parentElement;
            if (container && !container.classList.contains('hidden')) {
                loadData(true); // true: cache'i pas geç, zorunlu yükle
            } else {
                // Eğer panel gizlendiyse (başka sekmeye geçildiyse) durdur
                stopAutoRefresh();
            }
        }, 3000); // 3 saniyede bir güncelle
    }

    function stopAutoRefresh() {
        if (refreshInterval) {
            clearInterval(refreshInterval);
            refreshInterval = null;
        }
    }

    // Sayfa ilk yuklendiginde veya admin panelinde ilgili section gorunur gorunmez veriyi yukle
    function loadData(force) {
        if (!force && loaded && cache) {
            var r  = cache.risk       || cache.Risk       || [];
            var v  = cache.volatility || cache.Volatility || [];
            var an = cache.anomalies  || cache.Anomalies  || [];
            renderRisk(r);
            renderVol(v);
            updateSummaryCards(r, v);
            renderAnomalySection(an, r, v);   // anomali bölümü de cache'ten güncellenir
            startAutoRefresh();               // sekme geçişinde yeniden başlat
            return;
        }
        if (inflight) return;
        inflight = true;
        fetch(basePath + '?handler=FinancialAnalyticsData', { cache: 'no-store' })
            .then(function (r) {
                return r.json().then(function (j) {
                    if (!r.ok) throw new Error(j.error || ('HTTP ' + r.status));
                    return j;
                });
            })

            //Veri geldikten sonra tabloları ve özet kartlarını güncelle, ayrıca cache'e kaydet
            .then(function (j) {
                cache = j;
                loaded = true;
                var riskData   = j.risk        || j.Risk        || [];
                var volData    = j.volatility  || j.Volatility  || [];
                var arbData    = j.arbitrage   || j.Arbitrage;           // önce tanımla
                var anomalyData = j.anomalies  || j.Anomalies  || [];

                renderRisk(riskData);
                renderVol(volData);
                updateSummaryCards(riskData, volData);

                // Anomali kartlarını ve metriklerini gerçek veriden render et
                renderAnomalySection(anomalyData, riskData, volData);

                // Arbitraj verisi snapshot'a dahil edilmişse hemen render et (ayrı istek gerekmez).
                if (arbData && !arbInitialized) {
                    arbInitialized = true;
                    renderArbitrage(arbData);   // lastArbSnap'ı günceller + syncAnomalyArbMetric çağırır
                    startArbAutoRefresh();
                } else if (arbData) {
                    // Zaten başlatılmış ama yeni snapshot geldi — lastArbSnap'ı güncelle
                    lastArbSnap = arbData;
                    syncAnomalyArbMetric();
                }

                // Veri başarıyla yüklendiyse otomatik yenilemeyi başlat
                startAutoRefresh();
            })

            //Eger veri alma veya isleme sirasinda bir hata olursa, console'a logla ve tablolarin yerine hata mesajı goster
            .catch(function (err) {
                console.error('[FinancialAnalytics] Veri alinamadi:', err);
                var root = document.getElementById('ft-financial-analytics-wrap');
                var msg = err && err.message ? err.message : 'Bilinmeyen hata';
                var e = '<tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--ft-danger)">' + root.getAttribute('data-trans-error-loading').replace('{0}', msg) + '</td></tr>';
                var r1 = document.getElementById('ft-fa-risk-body');
                var r2 = document.getElementById('ft-fa-vol-body');
                if (r1) r1.innerHTML = e;
                if (r2) r2.innerHTML = e;
                
                // Hata olsa da periyodik denemeye devam et
                startAutoRefresh();
            })
            .finally(function () { inflight = false; });
    }

    // Anomali panelinin tüm bölümlerini gerçek veriden render eder
    function renderAnomalySection(cards, riskData, volData) {
        riskData = riskData || [];
        volData  = volData  || [];
        var root = document.getElementById('ft-financial-analytics-wrap');

        // ── 1) Uyarı Kartları ──────────────────────────────────────────
        var container = document.getElementById('ft-ano-alert-cards');
        if (container) {
            if (!cards || cards.length === 0) {
                container.innerHTML =
                    '<div style="grid-column:1/-1;text-align:center;color:var(--ft-text-muted);padding:2.5rem 1rem;font-size:0.85rem">' +
                    '<span class="material-symbols-outlined" style="font-size:28px;display:block;margin-bottom:8px;opacity:0.4">check_circle</span>' +
                    root.getAttribute('data-trans-no-anomalies') +
                    '</div>';
            } else {
                var iconMap  = { risk: 'warning', vol: 'error', arb: 'check_circle' };
                var classMap = { risk: 'risk',    vol: 'limit', arb: 'arb'          };
                var html = '';
                cards.forEach(function (c) {
                    var type = (getProp(c, 'type') || 'risk').toLowerCase();
                    var icon = iconMap[type]  || 'info';
                    var cls  = classMap[type] || 'risk';
                    html +=
                        '<div class="ft-ano-card ' + cls + '">' +
                          '<div class="ft-ano-card-header">' +
                            '<span class="material-symbols-outlined ft-ano-card-icon">' + esc(icon) + '</span>' +
                            '<span class="ft-ano-card-title">' + esc(getProp(c, 'title')       || '') + '</span>' +
                          '</div>' +
                          '<div class="ft-ano-card-symbol">' + esc(getProp(c, 'symbol')      || '') + '</div>' +
                          '<div class="ft-ano-card-desc">'   + esc(getProp(c, 'description') || '') + '</div>' +
                          '<div class="ft-ano-card-footer">' +
                            '<span class="ft-ano-card-time">'  + esc(getProp(c, 'time')  || '') + '</span>' +
                            '<span class="ft-ano-card-badge">' + esc(getProp(c, 'badge') || '') + '</span>' +
                          '</div>' +
                        '</div>';
                });
                container.innerHTML = html;
            }
        }

        // ── 2) Risk Ortalaması ─────────────────────────────────────────
        var riskAvg = 0;
        if (riskData.length > 0) {
            riskData.forEach(function (r) { riskAvg += (getProp(r, 'riskScore') || 0); });
            riskAvg = Math.round(riskAvg / riskData.length);
        }
        var riskAvgKey   = riskAvg < 34 ? 'dusuk' : (riskAvg < 67 ? 'normal' : 'yuksek');
        var riskAvgLabel = riskAvg < 34 ? root.getAttribute('data-trans-risk-low') : (riskAvg < 67 ? root.getAttribute('data-trans-risk-normal') : root.getAttribute('data-trans-risk-high'));
        var elRisk = document.getElementById('ft-ano-m-risk');
        var elRiskBadge = document.getElementById('ft-ano-m-risk-badge');
        if (elRisk) elRisk.textContent = riskAvg;
        if (elRiskBadge) { elRiskBadge.textContent = riskAvgLabel; elRiskBadge.className = 'ft-ano-metric-badge ' + badgeClass(riskAvgKey); }

        // ── 3) Yüksek Volatilite Sayısı ───────────────────────────────
        var highVolCount = volData.filter(function (v) { return getProp(v, 'levelKey') === 'yuksek'; }).length;
        var elVol = document.getElementById('ft-ano-m-vol');
        var elVolBadge = document.getElementById('ft-ano-m-vol-badge');
        if (elVol) elVol.textContent = highVolCount;
        if (elVolBadge) elVolBadge.className = 'ft-ano-metric-badge ' + (highVolCount > 0 ? 'ft-fa-badge-yuksek' : 'ft-fa-badge-dusuk');

        // ── 4) Yüksek Riskli Sembol Sayısı ────────────────────────────
        var highRiskCount = riskData.filter(function (r) { return getProp(r, 'levelKey') === 'yuksek'; }).length;
        var elHR = document.getElementById('ft-ano-m-highrisk');
        var elHRBadge = document.getElementById('ft-ano-m-highrisk-badge');
        if (elHR) elHR.textContent = highRiskCount;
        if (elHRBadge) elHRBadge.className = 'ft-ano-metric-badge ' + (highRiskCount > 0 ? 'ft-fa-badge-yuksek' : 'ft-fa-badge-dusuk');

        // ── 5) Genel Piyasa Özeti ──────────────────────────────────────
        var summaryEl = document.getElementById('ft-ano-market-summary');
        if (summaryEl) {
            var parts = [];
            if (highRiskCount > 0) {
                var highRiskSyms = riskData
                    .filter(function (r) { return getProp(r, 'levelKey') === 'yuksek'; })
                    .map(function (r) { return getProp(r, 'symbol') || ''; }).join(', ');
                parts.push(root.getAttribute('data-trans-risk-level-high').replace('{0}', highRiskCount).replace('{1}', highRiskSyms));
            }
            if (highVolCount > 0) {
                var highVolSyms = volData
                    .filter(function (v) { return getProp(v, 'levelKey') === 'yuksek'; })
                    .map(function (v) { return getProp(v, 'symbol') || ''; }).join(', ');
                parts.push(root.getAttribute('data-trans-high-volatility').replace('{0}', highVolSyms));
            }
            summaryEl.textContent = parts.length > 0
                ? parts.join(' ')
                : root.getAttribute('data-trans-all-normal');
        }

        // ── 6) Üst özet kart — Anomali Durumu ─────────────────────────
        var svAno  = document.getElementById('ft-fa-sv-ano');
        var dotAno = document.getElementById('ft-fa-dot-ano');
        var totalAnomalies = highRiskCount + highVolCount;
        if (svAno)  svAno.textContent  = totalAnomalies > 0 ? root.getAttribute('data-trans-anomalies-detected').replace('{0}', totalAnomalies) : root.getAttribute('data-trans-no-anomalies-detected');
        if (dotAno) dotAno.style.background = totalAnomalies > 0 ? 'var(--ft-danger)' : 'var(--ft-text-muted)';

        // ── 7) Arbitraj sayısı — lastArbSnap üzerinden güncelle ───────
        syncAnomalyArbMetric();
    }

    //Sayfa yüklendiğinde tabları çalışır hale getir
    wireTabs();

    window['ftLoadFinancialAnalytics'] = function () {
        loadData(true); // Sekmeye her tıklandığında taze veri çek
    };

    // Sayfa ilk açıldığında veya yenilendiğinde (F5) otomatik yükleme kontrolü
    document.addEventListener('DOMContentLoaded', function () {
        var root = document.getElementById('ft-financial-analytics-wrap');
        if (!root) return;

        var container = root.closest('section') || root.parentElement;
        if (container && !container.classList.contains('hidden')) {
            loadData(true);
        }
    });

    // ────────────────────────────────────────────────────────────────────
    // ARBITRAJ BÖLÜMÜ
    // ────────────────────────────────────────────────────────────────────
    // Snapshot backend'den alinir (Instrument + latest price + default USDTRY secili rows).
    // Kullanici dropdown'u degistirince "handler=ArbitrageCompute" cagirilir, sadece ilgili satir guncellenir.
    // Her 10 sn'de bir, mevcut secimler korunarak tum satirlar icin compute yeniden calistirilir (taze fiyat).
    var arbSelections = {}; // mainSymbol -> counterSymbol
    var arbRefreshTimer = null;
    var arbInflight = false;
    var arbInitialized = false; // FinancialAnalyticsData ile zaten yüklendiyse true
    var lastArbSnap = null;    // Son arbitraj snapshot — anomali metriği için saklanır

    function fmtNum(v, digits) {
        if (v === null || v === undefined || isNaN(v)) return '—';
        return Number(v).toFixed(digits != null ? digits : 5).replace('.', ',');
    }
    function fmtPct(v) {
        if (v === null || v === undefined || isNaN(v)) return '—';
        var s = Number(v).toFixed(4).replace('.', ',') + '%';
        return (v > 0 ? '+' : '') + s;
    }
    function signalBadge(key, label) {
        var cls = 'ft-arb-badge-none';
        var root = document.getElementById('ft-financial-analytics-wrap');
        if (key === 'sell') cls = 'ft-arb-badge-sell';
        else if (key === 'buy') cls = 'ft-arb-badge-buy';
        return '<span class="ft-fa-badge ' + cls + '">' + esc(localizedSignal(root, key, label)) + '</span>';
    }
    function diffColor(v) {
        if (v === null || v === undefined || isNaN(v)) return 'var(--ft-text-muted)';
        if (v > 0) return 'var(--ft-secondary)'; // Pozitif -> Yeşil
        if (v < 0) return 'var(--ft-danger)';    // Negatif -> Kırmızı
        return 'var(--ft-text-muted)';
    }

    function buildCounterOptions(available, selected) {
        if (!available || !available.length)
            return '<option value="">—</option>';
        return available.map(function (s) {
            var sel = (s === selected) ? ' selected' : '';
            return '<option value="' + esc(s) + '"' + sel + '>' + esc(fmtSym(s)) + '</option>';
        }).join('');
    }

    function derivedLabel(row) {
        // Türetilen parite sembolunu küçük, soluk bir etiket olarak döndürür.
        // Beklenen ve Piyasa sütunlarının hangi parite için olduğunu gösterir.
        var sym = getProp(row, 'derivedSymbol') || '';
        if (!sym) return '';
        return '<div style="font-size:0.68rem;color:var(--ft-text-muted);margin-top:2px;letter-spacing:0.03em">'
            + esc(fmtSym(sym)) + '</div>';
    }

    function renderArbRow(row) {
        var mainSym = getProp(row, 'mainSymbol');
        var counterSym = getProp(row, 'counterSymbol');
        var hasCounter = !!counterSym;
        var derived = derivedLabel(row);
        var select = '<select class="ft-arb-select" data-arb-main="' + esc(mainSym) + '"' +
            (hasCounter ? '' : ' disabled') + '>' +
            buildCounterOptions(getProp(row, 'availableCounters'), counterSym) +
            '</select>';

        var derSym = getProp(row, 'derivedSymbol');
        var hintHtml = (hasCounter && derSym)
            ? '<div class="ft-arb-derived-hint" style="font-size:0.68rem;color:var(--ft-text-muted);margin-top:2px;text-align:center">→ ' + esc(fmtSym(derSym)) + '</div>'
            : '<div class="ft-arb-derived-hint" style="font-size:0.68rem;color:var(--ft-text-muted);margin-top:2px;text-align:center"></div>';

        var diff = getProp(row, 'diffPercent');
        return '<tr data-arb-row="' + esc(mainSym) + '">' +
            '<td style="text-align:center;font-weight:700">' + esc(fmtSym(mainSym)) + '</td>' +
            '<td style="text-align:center">' + select + hintHtml + '</td>' +
            '<td data-arb-field="expected" style="text-align:center;font-family:monospace;font-size:0.85rem">' + fmtNum(getProp(row, 'expectedPrice')) + derived + '</td>' +
            '<td data-arb-field="market" style="text-align:center;font-family:monospace;font-size:0.85rem">' + fmtNum(getProp(row, 'marketPrice')) + derived + '</td>' +
            '<td data-arb-field="diff" style="text-align:center;font-family:monospace;font-size:0.85rem;color:' + diffColor(diff) + '">' + fmtPct(diff) + '</td>' +
            '<td data-arb-field="signal" style="text-align:center">' + signalBadge(getProp(row, 'signalKey'), getProp(row, 'signal')) + '</td>' +
            '</tr>';
    }

    function updateArbRow(row) {
        var mainSym = getProp(row, 'mainSymbol');
        var counterSym = getProp(row, 'counterSymbol');
        var tr = document.querySelector('tr[data-arb-row="' + mainSym + '"]');
        if (!tr) return;

        // Karsi parite icin dropdown'daki secim sunucudan dogrulanmis hali ile guncellenir (fallback olmus olabilir).
        var sel = tr.querySelector('select.ft-arb-select');
        if (sel && sel.value !== counterSym) sel.value = counterSym || '';

        // Türetilen parite etiketini güncelle
        var derived = derivedLabel(row);
        var derSym = getProp(row, 'derivedSymbol');
        var derivedText = derSym ? fmtSym(derSym) : '';
        var selParent = sel ? sel.parentElement : null;
        if (selParent) {
            var hint = selParent.querySelector('.ft-arb-derived-hint');
            if (hint) hint.textContent = derivedText ? '→ ' + derivedText : '';
        }

        var exp = tr.querySelector('[data-arb-field="expected"]');
        var mkt = tr.querySelector('[data-arb-field="market"]');
        var dif = tr.querySelector('[data-arb-field="diff"]');
        var sig = tr.querySelector('[data-arb-field="signal"]');

        var expectedPrice = getProp(row, 'expectedPrice');
        var marketPrice = getProp(row, 'marketPrice');
        var diffPercent = getProp(row, 'diffPercent');

        if (exp) { exp.innerHTML = fmtNum(expectedPrice) + derived; }
        if (mkt) { mkt.innerHTML = fmtNum(marketPrice) + derived; }
        if (dif) {
            dif.textContent = fmtPct(diffPercent);
            dif.style.color = diffColor(diffPercent);
        }
        if (sig) sig.innerHTML = signalBadge(getProp(row, 'signalKey'), getProp(row, 'signal'));

        // lastArbSnap içindeki ilgili satırı da güncelle ki syncAnomalyArbMetric doğru sayısın
        if (lastArbSnap) {
            var snapRows = getProp(lastArbSnap, 'rows') || [];
            var mainSym2 = getProp(row, 'mainSymbol');
            for (var i = 0; i < snapRows.length; i++) {
                if (getProp(snapRows[i], 'mainSymbol') === mainSym2) {
                    snapRows[i] = row;
                    break;
                }
            }
        }
        syncAnomalyArbMetric();
    }

    // Arbitraj tablosundaki aktif sinyal sayısını okuyup anomali metriğini ve özet kartını günceller
    function syncAnomalyArbMetric() {
        var root = document.getElementById('ft-financial-analytics-wrap');
        var rows = lastArbSnap ? (getProp(lastArbSnap, 'rows') || []) : [];
        var count = rows.filter(function (r) {
            var sk = getProp(r, 'signalKey');
            return sk && sk !== 'none';
        }).length;

        // Anomali paneli alt metrik
        var elArb      = document.getElementById('ft-ano-m-arb');
        var elArbBadge = document.getElementById('ft-ano-m-arb-badge');
        if (elArb) elArb.textContent = count;
        if (elArbBadge) {
            elArbBadge.textContent = count > 0 ? root.getAttribute('data-trans-active') : root.getAttribute('data-trans-normal');
            elArbBadge.className = 'ft-ano-metric-badge ' + (count > 0 ? 'ft-fa-badge-dusuk' : 'ft-fa-badge-normal');
        }

        // Üst özet kart — Arbitraj Durumu
        var svArb  = document.getElementById('ft-fa-sv-arb');
        var dotArb = document.getElementById('ft-fa-dot-arb');
        if (svArb)  svArb.textContent = count > 0 ? root.getAttribute('data-trans-opportunities-exist').replace('{0}', count) : root.getAttribute('data-trans-no-opportunity');
        if (dotArb) dotArb.style.background = count > 0 ? 'var(--ft-secondary)' : 'var(--ft-text-muted)';
    }

    function renderArbitrage(snap) {
        lastArbSnap = snap;
        var tb = document.getElementById('ft-arb-body');
        var root = document.getElementById('ft-financial-analytics-wrap');
        if (!tb) return;
        var rows = getProp(snap, 'rows') || [];
        if (!rows.length) {
            tb.innerHTML = '<tr><td colspan="6" class="ft-fa-loading">' + root.getAttribute('data-trans-instrument-not-found') + '</td></tr>';
            syncAnomalyArbMetric();
            return;
        }
        // Mevcut secimleri snapshot'tan seed et (yalnizca daha onceden secilmemis olanlari).
        arbSelections = {};
        rows.forEach(function (r) {
            var m = getProp(r, 'mainSymbol');
            var c = getProp(r, 'counterSymbol');
            if (m) arbSelections[m] = c || '';
        });
        tb.innerHTML = rows.map(renderArbRow).join('');
        syncAnomalyArbMetric();
    }

    function loadArbitrageSnapshot() {
        if (arbInflight) return;
        arbInflight = true;
        var tb = document.getElementById('ft-arb-body');
        var root = document.getElementById('ft-financial-analytics-wrap');
        if (tb) tb.innerHTML = '<tr><td colspan="6" class="ft-fa-loading">' + root.getAttribute('data-trans-loading') + '</td></tr>';
        fetch(basePath + '?handler=ArbitrageSnapshot&t=' + Date.now(), { cache: 'no-store' })
            .then(function (r) {
                return r.json().then(function (j) {
                    if (!r.ok) throw new Error(j.error || ('HTTP ' + r.status));
                    return j;
                });
            })
            .then(function (snap) { renderArbitrage(snap); startArbAutoRefresh(); })
            .catch(function (err) {
                console.error('[Arbitrage] Snapshot hatasi:', err);
                var root = document.getElementById('ft-financial-analytics-wrap');
                if (tb) tb.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--ft-danger)">' + root.getAttribute('data-trans-error-loading').replace('{0}', esc(err.message || 'Bilinmeyen hata')) + '</td></tr>';
            })
            .finally(function () { arbInflight = false; });
    }

    function refreshArbitrageRows() {
        // Tum mevcut secimler icin tek tek compute cagirir. Az sayida sembol oldugu icin yeterince ucuz.
        var mains = Object.keys(arbSelections);
        if (!mains.length) return;
        mains.forEach(function (main) {
            var counter = arbSelections[main] || '';
            fetch(basePath + '?handler=ArbitrageCompute&main=' + encodeURIComponent(main) + '&counter=' + encodeURIComponent(counter) + '&t=' + Date.now(), { cache: 'no-store' })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (row) {
                    if (!row) return;
                    var m = getProp(row, 'mainSymbol');
                    if (!m) return;
                    // Kullanici istek gonderildikten sonra secimi degistirdiyse eski cevabi yoksay.
                    if (arbSelections[m] !== counter) return;
                    arbSelections[m] = getProp(row, 'counterSymbol') || '';
                    updateArbRow(row);
                })
                .catch(function (err) { console.warn('[Arbitrage] refresh:', main, err); });
        });
    }

    //Bu fonksiyon, arbitraj ekranındaki karşı parite (select) değiştirildiğinde çalışır.
    function onArbSelectChange(e) {
            var sel = e.target;                                                  //e.target = kullanıcının işlem yaptığı elementtir.
        if (!sel || !sel.matches('select.ft-arb-select')) return;
        var main = sel.getAttribute('data-arb-main');
        var counter = sel.value;
            arbSelections[main] = counter;                                          //Bu satır kullanıcının yaptığı son seçimi hafızada tutar
		
        //anlık hesaplamayı yapar cache kullanmaz, çünkü kullanıcı yeni bir seçim yapmış olabilir ve en güncel sonucu görmek isteyebilir.
        fetch(basePath + '?handler=ArbitrageCompute&main=' + encodeURIComponent(main) + '&counter=' + encodeURIComponent(counter) + '&t=' + Date.now(), { cache: 'no-store' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (row) {
                if (!row) return;
                var m = getProp(row, 'mainSymbol');
                if (!m) return;
                if (arbSelections[m] !== counter) return;
                arbSelections[m] = getProp(row, 'counterSymbol') || '';
                updateArbRow(row);
            })
            .catch(function (err) { console.error('[Arbitrage] compute:', err); });
    }

    function startArbAutoRefresh() {
        if (arbRefreshTimer) return;
        arbRefreshTimer = setInterval(function () {
            var root = document.getElementById('ft-financial-analytics-wrap');
            if (!root) { stopArbAutoRefresh(); return; }
            var container = root.closest('section') || root.parentElement;
            // Kapsayici sekme gizliyse veya arbitraj alt paneli gizliyse yenileme yapma (kaynak tasarrufu).
            var arbPanel = root.querySelector('[data-ft-panel="arb"]');
            var hidden = (container && container.classList.contains('hidden')) || (arbPanel && arbPanel.classList.contains('hidden'));
            if (hidden) return;
            refreshArbitrageRows();
        }, 3000);
    }
    function stopArbAutoRefresh() {
        if (arbRefreshTimer) { clearInterval(arbRefreshTimer); arbRefreshTimer = null; }
    }

    // Arbitraj tablosunu tek seferlik olay delegasyonu ile dinle (yeni renderdan sonra da calisir).
    document.addEventListener('change', onArbSelectChange);

    // ────────────────────────────────────────────────────────────────────
    // AI ASISTAN VE ANOMALI BÖLÜMÜ
    // ────────────────────────────────────────────────────────────────────
    
    window.ftAiAsk = function(question) {
        var input = document.getElementById('ft-ai-input');
        if (input) {
            input.value = question;
            ftAiSubmit();
        }
    };

    window.ftAiSubmit = function() {
        var input = document.getElementById('ft-ai-input');
        var btn = document.getElementById('ft-ai-send');
        var container = document.getElementById('ft-ai-msg-container');
        
        var text = (input.value || '').trim();
        if (!text || (btn && btn.disabled)) return;

        // Kullanıcı mesajını ekle
        appendAiMessage('user', text);
        input.value = '';
        input.style.height = 'auto';
        
        if (btn) btn.disabled = true;

        // Backend isteği
        fetch(basePath + '?handler=AIAsistanYorumla', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({ userQuestion: text, selectedSymbol: window.SelectedSymbol || null })
        })
        .then(function(r) { return r.ok ? r.json() : r.json().then(function(j){ throw new Error(j.error || 'Error'); }); })
        .then(function(res) {
            appendAiMessage('ai', res.responseText || res.ResponseText);
        })
        .catch(function(err) {
            console.error('[AI] Error:', err);
            var root = document.getElementById('ft-financial-analytics-wrap');
            appendAiMessage('ai', root.getAttribute('data-trans-ai-error').replace('{0}', err.message));
        })
        .finally(function() {
            if (btn) btn.disabled = false;
        });
    };

    function appendAiMessage(type, text) {
        var container = document.getElementById('ft-ai-msg-container');
        if (!container) return;

        var msgDiv = document.createElement('div');
        msgDiv.className = 'ft-ai-msg ' + type;
        
        // Markdown benzeri basit formatlama (satır sonları)
        var formatted = esc(text).replace(/\n/g, '<br>');
        msgDiv.innerHTML = formatted;

        var timeDiv = document.createElement('div');
        timeDiv.className = 'ft-ai-msg-time';
        var now = new Date();
        timeDiv.textContent = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
        msgDiv.appendChild(timeDiv);

        container.appendChild(msgDiv);
        container.scrollTop = container.scrollHeight;
    }

    // Input alanında Enter'a basınca gönder
    document.addEventListener('keydown', function(e) {
        if (e.target && e.target.id === 'ft-ai-input' && e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            ftAiSubmit();
        }
    });

    // Otomatik textarea yüksekliği
    document.addEventListener('input', function(e) {
        if (e.target && e.target.id === 'ft-ai-input') {
            e.target.style.height = 'auto';
            e.target.style.height = (e.target.scrollHeight) + 'px';
        }
    });

    // Anomali sekmesine tıklandığında güncelleme zamanını yenile
    (function wireAnoTab() {
        var root = document.getElementById('ft-financial-analytics-wrap');
        if (!root) return;
        var anoTabBtn = root.querySelector('.ft-fa-tab[data-ft-sub="ano"]');
        if (!anoTabBtn) return;
        anoTabBtn.addEventListener('click', function () {
            var timeSpan = document.getElementById('ft-ano-last-update');
            if (timeSpan) {
                var now = new Date();
                timeSpan.textContent = now.toLocaleTimeString();
            }
        });

        // ── Panel Collapse / Expand ──
        var collapseBtn = document.getElementById('ft-ai-collapse-btn');
        var panel = document.getElementById('ft-ai-panel');
        var resizer = document.getElementById('ft-ai-resizer');

        if (collapseBtn && panel) {
            collapseBtn.addEventListener('click', function () {
                var isCollapsed = panel.classList.contains('collapsed');
                if (isCollapsed) {
                    panel.classList.remove('collapsed');
                    if (resizer) resizer.classList.remove('panel-hidden');
                } else {
                    panel.classList.add('collapsed');
                    if (resizer) resizer.classList.add('panel-hidden');
                }
            });
        }

        // ── Suggested Questions Accordion ──
        var suggestHeader = document.getElementById('ft-ai-suggest-header');
        var suggestBody   = document.getElementById('ft-ai-suggest-body');
        var suggestChevron = document.getElementById('ft-ai-suggest-chevron');

        if (suggestHeader && suggestBody) {
            suggestHeader.addEventListener('click', function () {
                var isOpen = suggestBody.classList.contains('open');
                if (isOpen) {
                    suggestBody.classList.remove('open');
                    if (suggestChevron) suggestChevron.classList.remove('open');
                } else {
                    suggestBody.classList.add('open');
                    if (suggestChevron) suggestChevron.classList.add('open');
                }
            });
        }

        // ── Resize Logic ──
        if (resizer && panel) {
            var isResizing = false;
            resizer.addEventListener('mousedown', function(e) {
                isResizing = true;
                resizer.classList.add('resizing');
                document.body.style.cursor = 'col-resize';
                document.body.style.userSelect = 'none';
            });

            document.addEventListener('mousemove', function(e) {
                if (!isResizing) return;
                
                var container = root.querySelector('.ft-ano-container');
                if (!container) return;

                var containerRect = container.getBoundingClientRect();
                var newWidth = containerRect.right - e.clientX;
                
                // Sınırlar (min-max style içinde de var ama js ile kontrol daha sağlıklı)
                if (newWidth >= 300 && newWidth <= 800) {
                    panel.style.width = newWidth + 'px';
                }
            });

            document.addEventListener('mouseup', function() {
                if (isResizing) {
                    isResizing = false;
                    resizer.classList.remove('resizing');
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';
                }
            });
        }
    })();

    // Arbitraj sekmesine tiklandiginda:
    // - Veri FinancialAnalyticsData ile zaten yuklenmediyse snapshot ister (eski yedek yol).
    // - Zaten yuklenmiş ise sadece auto-refresh'i başlatır.
    (function wireArbLazyLoad() {
        var root = document.getElementById('ft-financial-analytics-wrap');
        if (!root) return;
        var arbTabBtn = root.querySelector('.ft-fa-tab[data-ft-sub="arb"]');
        if (!arbTabBtn) return;
        arbTabBtn.addEventListener('click', function () {
            if (!arbInitialized) {
                arbInitialized = true;
                loadArbitrageSnapshot();
            } else {
                startArbAutoRefresh();
            }
        });
    })();
})();
</script>
